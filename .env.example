# Local PostgreSQL; Docker Compose uses its internal database hostname instead.
DATABASE_URL=postgresql://waypoint:local-only-password@127.0.0.1:54329/waypoint
AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
SEED_DEMO_PASSWORD=WaypointDemo!2026
WEB_ORIGIN=http://localhost:5173
API_HOST=127.0.0.1
API_PORT=3001
API_TRUST_PROXY=false
API_PROXY_TARGET=http://127.0.0.1:3001
VITE_API_BASE_URL=/api
SESSION_HOURS=8
NODE_ENV=development
# Explicit independently authored public judging data. Default false keeps installation auth-only.
# Production keeps HTTPS/secure cookies; this flag authorizes only a separate SYNTHETIC judge database.
PUBLIC_JUDGE_DEMO=false
# Safe starter references for normal workflows; creates no orders or transactions.
# Keep PUBLIC_JUDGE_DEMO=false and omit DISPATCHER_DEMO_DATE when enabled.
STARTER_REFERENCE_DATA=false
# Hosted deployment supplies fresh DATABASE_URL/AUTH_SECRET/SEED_DEMO_PASSWORD and HTTPS WEB_ORIGIN.
# Railway injects PORT; production binds :: unless API_HOST is explicitly configured.
# Explicitly opt in only for independently authored Store judge/test fixtures.
STORE_ALLOW_SYNTHETIC=false
# Explicit planning opt-in for independently authored non-production judge fixtures.
PLANNING_ALLOW_SYNTHETIC=false
# Optional Dispatcher default day; it selects context and does not create calendar data.
# DISPATCHER_DEMO_DATE=2040-02-06
# Compose initialization: replace these passwords before any shared deployment.
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=waypoint
WEB_PORT=5173

#!/bin/sh
set -eu

PORT="${PORT:-80}"
API_UPSTREAM="${API_UPSTREAM:-http://api:3001}"
case "$PORT" in
  ''|*[!0-9]*) echo 'PORT must be a numeric TCP port.' >&2; exit 1 ;;
esac
if [ "$PORT" -lt 1 ] || [ "$PORT" -gt 65535 ]; then
  echo 'PORT must be between 1 and 65535.' >&2; exit 1
fi
if ! printf '%s\n' "$API_UPSTREAM" | grep -Eq '^https?://[[:alnum:].-]+(:[0-9]+)?$'; then
  echo 'API_UPSTREAM must be an HTTP origin with a hostname and optional port.' >&2; exit 1
fi

# Runtime DNS supports Compose and Railway's IPv4/IPv6 private service names.
NGINX_LOCAL_RESOLVERS="$(awk 'BEGIN { ORS=" " } $1=="nameserver" { if ($2 ~ ":") print "["$2"]"; else print $2 }' /etc/resolv.conf)"
NGINX_LOCAL_RESOLVERS="${NGINX_LOCAL_RESOLVERS% }"
if [ -z "$NGINX_LOCAL_RESOLVERS" ]; then
  echo 'No container DNS resolver is available for API_UPSTREAM.' >&2; exit 1
fi
NGINX_ENVSUBST_FILTER='^(API_UPSTREAM|PORT|NGINX_LOCAL_RESOLVERS)$'
export PORT API_UPSTREAM NGINX_LOCAL_RESOLVERS NGINX_ENVSUBST_FILTER

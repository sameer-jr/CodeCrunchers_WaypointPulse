{
  "name": "codecrunchers-waypoint-pulse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/web", "apps/api", "packages/shared"],
  "engines": { "node": ">=22.13" },
  "scripts": {
    "postinstall": "prisma generate && npm run build -w @waypoint/shared",
    "dev": "concurrently -k -n api,web \"npm run dev -w @waypoint/api\" \"npm run dev -w @waypoint/web\"",
    "build": "npm run build -w @waypoint/shared && npm run build -w @waypoint/api && npm run build -w @waypoint/web",
    "typecheck": "npm run build -w @waypoint/shared && tsc --noEmit -p packages/shared/tsconfig.check.json && tsc --noEmit -p apps/api/tsconfig.check.json && tsc --noEmit -p apps/web && tsc --noEmit -p tsconfig.scripts.json",
    "lint": "eslint apps packages prisma scripts",
    "test": "node scripts/test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "seed:public-judge": "tsx scripts/seed-public-judge.ts",
    "import:reference": "tsx scripts/import-reference-data.ts",
    "demo:assign-store": "tsx scripts/assign-store.ts",
    "demo:store-judge": "node scripts/setup-store-judge.mjs",
    "demo:store-synthetic": "tsx scripts/setup-store-synthetic.ts",
    "demo:assign-dispatcher": "tsx scripts/assign-dispatcher.ts",
    "demo:dispatcher-judge": "node scripts/setup-dispatcher-judge.mjs",
    "dev:dispatcher-judge": "node scripts/dev-dispatcher-judge.mjs",
    "demo:allocation-judge": "node scripts/setup-allocation-judge.mjs",
    "dev:allocation-judge": "node scripts/dev-allocation-judge.mjs",
    "demo:loader-judge": "node scripts/setup-loader-judge.mjs",
    "dev:loader-judge": "node scripts/dev-loader-judge.mjs",
    "demo:driver-judge": "node scripts/setup-driver-judge.mjs",
    "demo:assign-driver": "tsx scripts/assign-driver.ts",
    "dev:driver-judge": "node scripts/dev-driver-judge.mjs",
    "preview:driver-judge": "node scripts/dev-driver-judge.mjs --preview",
    "setup:local": "node scripts/setup-local.mjs",
    "dev:db": "node scripts/dev-db.mjs",
    "check:safety": "node scripts/check-safety.mjs",
    "verify:docker": "docker compose exec -T api node scripts/verify-docker.mjs",
    "reset:public-demo": "tsx scripts/reset-public-judge.ts"
  },
  "dependencies": { "@prisma/client": "6.19.3" },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "^10.11.0",
    "globals": "^16.5.0",
    "ignore": "^7.0.5",
    "prisma": "6.19.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "yaml": "^2.8.1"
  },
  "overrides": { "deepmerge-ts": "^8.0.2" }
}
